# Copy this to .env and fill in your keys. Never commit .env.

# Polygon.io — free tier at https://polygon.io/
POLYGON_API_KEY=your_polygon_key_here

# SEC EDGAR — no key needed, but set a descriptive User-Agent (required by SEC)
# Format: "Your Name your@email.com" — SEC rate-limits anonymous requests
EDGAR_USER_AGENT="Your Name your@email.com"

# SQLite path (relative to project root)
DB_PATH=data/spike.db
